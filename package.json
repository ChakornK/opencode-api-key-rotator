{
  "name": "opencode-nim-rotator",
  "version": "0.2.0",
  "description": "An OpenCode plugin for managing and rotating multiple NVIDIA NIM API keys",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "opencode-nim-rotator": "./bin/opencode-nim-rotator.ts"
  },
  "scripts": {
    "build": "tsc",
    "tui": "bun run bin/opencode-nim-rotator.ts",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "uninstall": "node scripts/uninstall.js",
    "lint": "biome lint src/",
    "format": "prettier -w ."
  },
  "keywords": [
    "opencode",
    "plugin",
    "nvidia",
    "nim",
    "api-key",
    "rotation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChakornK/opencode-api-key-rotator.git"
  },
  "bugs": {
    "url": "https://github.com/ChakornK/opencode-api-key-rotator/issues"
  },
  "homepage": "https://github.com/ChakornK/opencode-api-key-rotator#readme",
  "author": "ChakornK",
  "license": "MIT",
  "files": [
    "dist",
    "bin",
    "scripts"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.14",
    "@opentui/core": "^0.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "bun": "latest"
  },
  "peerDependenciesMeta": {
    "bun": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
